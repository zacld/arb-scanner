# eBay Browse API credentials — free, register at https://developer.ebay.com/my/keys
# Create a "keyset" for the Production environment; you want the App ID (client id)
# and Cert ID (client secret). No user token needed — the app token is enough
# for the Browse API.
EBAY_CLIENT_ID=your-app-id-here
EBAY_CLIENT_SECRET=your-cert-id-here
